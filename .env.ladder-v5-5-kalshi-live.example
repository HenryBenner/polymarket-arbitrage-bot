EXCHANGE=kalshi
STRATEGY_MODE=ladder_v5.5
EXECUTION_MODE=live
DRY_RUN=false

POLL_INTERVAL_MS=5000
MINUTES_BEFORE_CLOSE_MIN=0
MINUTES_BEFORE_CLOSE_MAX=15
CRYPTO_MARKETS=KXBTC15M

KALSHI_API_HOST=https://external-api.kalshi.com/trade-api/v2
KALSHI_WS_HOST=wss://external-api-ws.kalshi.com/trade-api/ws/v2
KALSHI_API_KEY_ID=your-kalshi-api-key-id
KALSHI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
KALSHI_SUBACCOUNT=0

KALSHI_TAKER_FEE_RATE=0.07
KALSHI_MAKER_FEE_RATE=0
KALSHI_FEE_OVERRIDES=

# Begin live validation at scale 1 with the smallest V1-sized phased lots.
LADDER_SIZE_SCALE=1
LADDER_MAX_USDC_PER_MARKET=65
LADDER_V5_MAX_IMBALANCE=40
LADDER_V5_MAX_PAIR_COST=0.98

# Stores the authenticated live order/fill ledger and V5.5 submission locks.
PAPER_STATE_PATH=./data/live-ladder-v5-5-phased-kalshi

LIVE_TRADING_ACK=I_UNDERSTAND_REAL_MONEY_IS_AT_RISK
LADDER_LIVE_ACK=I_UNDERSTAND_LADDER_MODE_CAN_LOSE_REAL_MONEY
