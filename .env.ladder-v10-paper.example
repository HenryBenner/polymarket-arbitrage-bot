EXCHANGE=kalshi
STRATEGY_MODE=ladder_v10
EXECUTION_MODE=paper
DRY_RUN=true

POLL_INTERVAL_MS=5000
# Observe the full market so 120-second path and queue features are warm at 5m.
MINUTES_BEFORE_CLOSE_MIN=0
MINUTES_BEFORE_CLOSE_MAX=15
CRYPTO_MARKETS=KXBTC15M

KALSHI_API_HOST=https://external-api.kalshi.com/trade-api/v2
KALSHI_WS_HOST=wss://external-api-ws.kalshi.com/trade-api/ws/v2
KALSHI_API_KEY_ID=your-kalshi-api-key-id
KALSHI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
KALSHI_SUBACCOUNT=0
KALSHI_TAKER_FEE_RATE=0.07
KALSHI_MAKER_FEE_RATE=0
KALSHI_FEE_OVERRIDES=

LADDER_MAX_USDC_PER_MARKET=50
LADDER_V10_CHEAP_PRICE=0.10
LADDER_V10_FAVORITE_PRICE=0.80
LADDER_V10_MID_SHARES=20
LADDER_V10_TARGET_SHARES=40
LADDER_V10_MAX_PAIR_COST=0.97
LADDER_V10_SCORE_LOW=40
LADDER_V10_SCORE_HIGH=70
LADDER_V10_BURN_IN_MARKETS=32
LADDER_V10_SNAPSHOT_INTERVAL_MS=1000
LADDER_V10_SOURCE_STALE_MS=2000
LADDER_V10_COINBASE_WS_HOST=wss://advanced-trade-ws.coinbase.com
LADDER_V10_COINBASE_PRODUCT=BTC-USD

PAPER_STARTING_USDC=2000
PAPER_STATE_PATH=./data/paper-ladder-v10-btc

LIVE_TRADING_ACK=
LADDER_LIVE_ACK=
