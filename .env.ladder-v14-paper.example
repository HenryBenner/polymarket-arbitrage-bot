EXCHANGE=kalshi
STRATEGY_MODE=ladder_v14
EXECUTION_MODE=paper
DRY_RUN=true

# V14 runs one independent conditional model per series while sharing the
# paper portfolio allocator. Add or remove any validated Kalshi 15m series.
CRYPTO_MARKETS=KXBTC15M,KXETH15M,KXSOL15M
MINUTES_BEFORE_CLOSE_MIN=0
MINUTES_BEFORE_CLOSE_MAX=15
POLL_INTERVAL_MS=5000

# Paper capital is accounting-only for V14. Orders are governed by marginal
# EV; these metrics remain available in paper-state.json.
PAPER_STARTING_USDC=100
PAPER_STATE_PATH=./data/paper-ladder-v14

LADDER_V14_PRIOR_STRENGTH=5
LADDER_V14_FLOW_WINDOW_SECONDS=60
LADDER_V14_VOLATILITY_WINDOW_SECONDS=60
LADDER_V14_FINAL_CLEANUP_SECONDS=30
# Opening orders are replanned on this economic lifetime. Displayed depth is
# used as weak pseudo-flow only until qualifying trade flow is observed.
LADDER_V14_QUOTE_LIFETIME_SECONDS=5
LADDER_V14_PSEUDO_FLOW_DEPTH_FRACTION=1
LADDER_V14_QUANTITY_QUEUE_WEIGHT=1
LADDER_V14_REACHABILITY_MULTIPLIER=1.5

# Sequential collection phase: quote one small near-touch pair without using
# the still-learning EV model as an entry gate. Set false to enable EV gating.
LADDER_V14_VOLUME_FIRST_MODE=true
LADDER_V14_CYCLE_SHARES=10
LADDER_V14_VOLUME_FIRST_PAIR_COST=0.99

KALSHI_API_HOST=https://external-api.kalshi.com/trade-api/v2
KALSHI_WS_HOST=wss://external-api-ws.kalshi.com/trade-api/ws/v2
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
KALSHI_SUBACCOUNT=0
KALSHI_TAKER_FEE_RATE=0.07
KALSHI_MAKER_FEE_RATE=0
