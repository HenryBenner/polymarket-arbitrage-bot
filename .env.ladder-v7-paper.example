EXCHANGE=kalshi
STRATEGY_MODE=ladder_v7
EXECUTION_MODE=paper
DRY_RUN=true

POLL_INTERVAL_MS=5000
# V7 enters only from 5-2. Continue scanning through close so the resting
# 10-cent maker is cancelled at the two-minute cutoff and markets settle.
MINUTES_BEFORE_CLOSE_MIN=0
MINUTES_BEFORE_CLOSE_MAX=5

# BTC was the strongest and most stable market in the retrospective sample.
# Add KXETH15M and KXDOGE15M only as separate forward-test cohorts.
CRYPTO_MARKETS=KXBTC15M

KALSHI_API_HOST=https://external-api.kalshi.com/trade-api/v2
KALSHI_WS_HOST=wss://external-api-ws.kalshi.com/trade-api/ws/v2
KALSHI_API_KEY_ID=your-kalshi-api-key-id
KALSHI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
KALSHI_SUBACCOUNT=0

KALSHI_TAKER_FEE_RATE=0.07
KALSHI_MAKER_FEE_RATE=0
KALSHI_FEE_OVERRIDES=

# Scale 4 produces the 40-share exposure used for the retrospective result.
# The hard cap prevents a scale or venue-minimum change from increasing it.
LADDER_SIZE_SCALE=4
LADDER_MAX_USDC_PER_MARKET=50
LADDER_V7_CHEAP_PRICE=0.10
LADDER_V7_FAVORITE_PRICE=0.80
LADDER_V7_MAX_SHARES=40

PAPER_STARTING_USDC=2000
PAPER_STATE_PATH=./data/paper-ladder-v7-btc

LIVE_TRADING_ACK=
LADDER_LIVE_ACK=
