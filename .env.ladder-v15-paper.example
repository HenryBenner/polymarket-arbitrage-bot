EXCHANGE=kalshi
STRATEGY_MODE=ladder_v15
EXECUTION_MODE=paper
DRY_RUN=true
CRYPTO_MARKETS=KXBTC15M,KXETH15M,KXSOL15M
MINUTES_BEFORE_CLOSE_MIN=0
MINUTES_BEFORE_CLOSE_MAX=15
POLL_INTERVAL_MS=5000
PAPER_STARTING_USDC=100
PAPER_STATE_PATH=./data/paper-ladder-v15

# Paper cash is accounting-only. Pending entries count against exposure.
LADDER_V15_ENTRY_MINUTES_MAX=15
LADDER_V15_ENTRY_MINUTES_MIN=2
LADDER_V15_CHEAP_PRICE=0.10
LADDER_V15_FAVORITE_PRICE=0.80
LADDER_V15_MIN_NET_EDGE=0.03
LADDER_V15_CYCLE_SHARES=40
LADDER_V15_MAX_UNMATCHED_PER_MARKET=40
LADDER_V15_MAX_UNMATCHED_PORTFOLIO=120
LADDER_V15_RETRY_LIMIT=4
LADDER_V15_RETRY_COOLDOWN_MS=350
LADDER_V15_CLEANUP_SECONDS=30
LADDER_V15_EMERGENCY_PAIR_COST=1.02

# Websocket authentication is required even for paper execution.
KALSHI_API_HOST=https://external-api.kalshi.com/trade-api/v2
KALSHI_WS_HOST=wss://external-api-ws.kalshi.com/trade-api/ws/v2
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=
KALSHI_SUBACCOUNT=0
KALSHI_TAKER_FEE_RATE=0.07
KALSHI_MAKER_FEE_RATE=0
