EXCHANGE=polymarket
STRATEGY_MODE=ladder_v8
EXECUTION_MODE=paper
DRY_RUN=true

POLL_INTERVAL_MS=5000
MARKET_SLUG_PREFIXES=btc-updown-15m
MINUTES_BEFORE_CLOSE_MIN=0
MINUTES_BEFORE_CLOSE_MAX=15

# August 3-4 Odahoa BTC 15-minute share schedule in America/New_York:
# 00-06: 5, 06-09: 16, 09-15: 120, 15-18: 32, 18-24: 8.
LADDER_V8_SIZE_SCALE=1
LADDER_V8_MAX_SHARES_PER_ORDER=120
# The observed p90 unmatched inventory was roughly 213-250 shares. V8 stops
# adding to the heavy side and cancels its resting orders at this threshold.
LADDER_V8_MAX_UNMATCHED_SHARES=240

# Nine complementary pairs can commit up to 9 * 120 = $1,080 in the daytime
# tier. The extra room absorbs rounding; this is paper capital, not a target.
LADDER_MAX_USDC_PER_MARKET=1100
PAPER_STARTING_USDC=25000
PAPER_STATE_PATH=./data/paper-ladder-v8-btc

CLOB_HOST=https://clob.polymarket.com
GAMMA_API_HOST=https://gamma-api.polymarket.com
CHAIN_ID=137

LIVE_TRADING_ACK=
LADDER_LIVE_ACK=
