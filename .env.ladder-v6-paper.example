# Competitive paired-maker / maker-FOK completion paper candidate.
STRATEGY_MODE=ladder_v6
EXECUTION_MODE=paper

POLL_INTERVAL_MS=5000
MARKET_SLUG_PREFIXES=btc-updown-15m
# V6 enters only from 5-2. Scanning continues to zero so it can enforce the
# two-minute cancellation cutoff.
MINUTES_BEFORE_CLOSE_MIN=0
MINUTES_BEFORE_CLOSE_MAX=5

# V6 uses a fixed per-side share-risk cap rather than ladder scale.
LADDER_SIZE_SCALE=1
LADDER_V6_MAX_UNMATCHED_SHARES=40
LADDER_V6_MIN_NET_EDGE=0.01
LADDER_V6_SAFETY_BUFFER=0.01
LADDER_V6_MAX_RESCUE_LOSS=0.02

PAPER_STARTING_USDC=2000
PAPER_STATE_PATH=./data/paper-ladder-v6

CLOB_HOST=https://clob.polymarket.com
GAMMA_API_HOST=https://gamma-api.polymarket.com
CHAIN_ID=137

LIVE_TRADING_ACK=
LADDER_LIVE_ACK=
