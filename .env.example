# Existing reverse behavior remains the default. Select an Odahoa mode
# explicitly and use an isolated state path for each running bot.
STRATEGY_MODE=reverse

# Venue selector: polymarket or kalshi.
EXCHANGE=polymarket

# dry_run = intent logs, paper = fill-aware simulation, live = real orders.
# When omitted, the legacy DRY_RUN setting below is still honored.
# EXECUTION_MODE=dry_run

# Poll active 15m markets every N ms
POLL_INTERVAL_MS=5000

# Markets to trade (comma-separated slug prefixes)
MARKET_SLUG_PREFIXES=btc-updown-15m,eth-updown-15m

# Reverse side: limit BUY at 7-10c on the cheap (underdog) outcome
CHEAP_BUY_MIN=0.07
CHEAP_BUY_MAX=0.10
CHEAP_ORDER_USDC=10

# Hedge side: limit BUY at 90-95c on the favorite outcome
ENABLE_EXPENSIVE_HEDGE=true
EXPENSIVE_BUY_MIN=0.90
EXPENSIVE_BUY_MAX=0.95
EXPENSIVE_ORDER_USDC=50

# Max shares per order (@odahoa typically uses ~90)
MAX_SHARES_PER_ORDER=90

# Only trade when this many minutes remain in the 15m window (0-15)
MINUTES_BEFORE_CLOSE_MIN=0
MINUTES_BEFORE_CLOSE_MAX=15

# Safety: dry-run is the default. Live trading also requires LIVE_TRADING_ACK.
DRY_RUN=true
LIVE_TRADING_ACK=

# Timed ladder settings (scale is also used by ladder_v5, ladder_v5.5, and V7)
LADDER_PRESET=odahoa_v1
LADDER_SIZE_SCALE=1
# Applies independently to every ladder market in paper and live mode.
LADDER_MAX_USDC_PER_MARKET=65
# Deprecated fallback: LADDER_LIVE_MAX_USDC_PER_MARKET=65
PAPER_STARTING_USDC=100
PAPER_STATE_PATH=./data/paper
LADDER_LIVE_ACK=

# Static maker settings (used only with STRATEGY_MODE=odahoa_static_maker)
STATIC_MAKER_MAX_SHARES=90
STATIC_MAKER_MAX_USDC_PER_MARKET=500

# Pair-lock settings (used only with STRATEGY_MODE=odahoa_ladder_2)
PAIR_LOCK_MAX_COST=0.985
PAIR_LOCK_RESIDUAL_FRACTION=0.10
PAIR_LOCK_RESIDUAL_MAX_PRICE=0.20

# Audit-derived V5 settings (paper on either venue; live on Kalshi)
LADDER_V5_MAX_IMBALANCE=70
LADDER_V5_MAX_PAIR_COST=0.98

# Paired-maker V6 settings (used only with STRATEGY_MODE=ladder_v6)
LADDER_V6_MAX_UNMATCHED_SHARES=40
LADDER_V6_MIN_NET_EDGE=0.01
LADDER_V6_SAFETY_BUFFER=0.01
LADDER_V6_MAX_RESCUE_LOSS=0.02

# Fixed asymmetric V7 settings (used only with STRATEGY_MODE=ladder_v7)
LADDER_V7_CHEAP_PRICE=0.10
LADDER_V7_FAVORITE_PRICE=0.80
LADDER_V7_MAX_SHARES=40

# CLOB / wallet (required when DRY_RUN=false)
# Type 3 (POLY_1271): the owner/session-signer key and deposit wallet address.
PRIVATE_KEY=0x...
FUNDER_ADDRESS=0x...
SIGNATURE_TYPE=3
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137

# Optional: reuse existing API credentials instead of deriving
# CLOB_API_KEY=
# CLOB_SECRET=
# CLOB_PASSPHRASE=

# Kalshi (used only when EXCHANGE=kalshi)
# Production:
KALSHI_API_HOST=https://external-api.kalshi.com/trade-api/v2
KALSHI_WS_HOST=wss://external-api-ws.kalshi.com/trade-api/ws/v2
# For demo, change both hosts together:
# KALSHI_API_HOST=https://external-api.demo.kalshi.co/trade-api/v2
# KALSHI_WS_HOST=wss://external-api-ws.demo.kalshi.co/trade-api/ws/v2
# Preferred Kalshi selector. The chosen STRATEGY_MODE runs on every series.
CRYPTO_MARKETS=KXADA15M,KXBCH15M,KXBNB15M,KXBTC15M,KXDOGE15M,KXETH15M,KXHYPE15M,KXNEAR15M,KXSOL15M,KXTON15M,KXXRP15M,KXZEC15M
# Deprecated fallback when CRYPTO_MARKETS is not set:
# KALSHI_SERIES_TICKERS=KXBTC15M
KALSHI_API_KEY_ID=
# Paste the complete RSA PEM key using literal \n between its lines.
# Keep this quoted and never commit your populated .env.
KALSHI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
KALSHI_SUBACCOUNT=0
# General fee formula coefficients. Verify the selected market's current fee
# disclosure; some Kalshi series have special maker/taker fees.
KALSHI_TAKER_FEE_RATE=0.07
KALSHI_MAKER_FEE_RATE=0
# Optional SERIES:TAKER:MAKER overrides; unspecified series use the rates above.
# KALSHI_FEE_OVERRIDES=KXBTC15M:0.07:0,KXETH15M:0.07:0
