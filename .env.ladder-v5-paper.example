# Forward-test candidate from the 179-session paper audit.
# Paper-only: no wallet or authenticated CLOB credentials are needed.
STRATEGY_MODE=ladder_v5
EXECUTION_MODE=paper

POLL_INTERVAL_MS=5000
MARKET_SLUG_PREFIXES=btc-updown-15m
# Keep scanning through two minutes so resting V5 orders are cancelled when
# its 5-2 entry window closes.
MINUTES_BEFORE_CLOSE_MIN=0
MINUTES_BEFORE_CLOSE_MAX=5

# Scale 4 needs a $70 market cap to keep both selected rungs intact.
LADDER_SIZE_SCALE=4
LADDER_MAX_USDC_PER_MARKET=70
LADDER_V5_MAX_IMBALANCE=70
LADDER_V5_MAX_PAIR_COST=0.98

PAPER_STARTING_USDC=2000
PAPER_STATE_PATH=./data/paper-ladder-v5

CLOB_HOST=https://clob.polymarket.com
GAMMA_API_HOST=https://gamma-api.polymarket.com
CHAIN_ID=137

LIVE_TRADING_ACK=
LADDER_LIVE_ACK=
